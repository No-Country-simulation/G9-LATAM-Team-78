VITE_GEMINI_API_KEY=tu_clave_gemini_aqui

# URL del backend Spring Boot (API Gateway)
# LOCAL:      http://localhost:8080/api
# PRODUCCIÓN: http://147.15.27.26:8080/api   ← IP pública de tu instancia OCI
VITE_BACKEND_URL=http://147.15.27.26:8080/api

